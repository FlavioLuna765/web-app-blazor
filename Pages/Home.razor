@page "/"

<PageTitle>FCG - Home</PageTitle>

<div class="home-page">

    <section class="hero-section">
        <div class="hero-content">
            <span class="hero-badge">FIAP Cloud Games</span>

            <h1>
                Seu próximo jogo
                <span>começa aqui.</span>
            </h1>

            <p>
                Explore nosso catálogo, descubra novos jogos
                e construa sua biblioteca digital.
            </p>

            <div class="hero-actions">
                <a href="/catalogo" class="primary-button">
                    Explorar catálogo
                </a>

                <a href="/login" class="secondary-button">
                    Minha conta
                </a>
            </div>
        </div>

        <div class="hero-decoration">
            <div class="game-card">
                <div class="game-card-icon">??</div>
                <span>GAME STORE</span>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="section-header">
            <div>
                <span class="section-label">EXPLORE</span>
                <h2>O que você pode fazer</h2>
            </div>
        </div>

        <div class="feature-grid">

            <article class="feature-card">
                <div class="feature-icon">??</div>

                <h3>Catálogo</h3>

                <p>
                    Encontre jogos disponíveis para compra
                    e descubra novos títulos.
                </p>

                <a href="/catalogo">
                    Ver catálogo ?
                </a>
            </article>

            <article class="feature-card">
                <div class="feature-icon">??</div>

                <h3>Biblioteca</h3>

                <p>
                    Acesse os jogos adquiridos e mantenha
                    sua coleção organizada.
                </p>

                <a href="/biblioteca">
                    Minha biblioteca ?
                </a>
            </article>

            <article class="feature-card">
                <div class="feature-icon">??</div>

                <h3>Minha conta</h3>

                <p>
                    Gerencie seus dados pessoais e
                    configurações da sua conta.
                </p>

                <a href="/perfil">
                    Meu perfil ?
                </a>
            </article>

        </div>
    </section>

</div>
